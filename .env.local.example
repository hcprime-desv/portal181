# Copie para .env.local e preencha. Não commitar o .env.local de verdade.
# (Prefixo NEXT_PUBLIC_ porque o SDK do Firebase também roda no navegador
# — nos listeners em tempo real e nos fluxos de denúncia/chat — mesmo
# agora que existe um servidor Node.js de verdade (SSR/ISR, ver
# next.config.js: output "standalone") fazendo a leitura inicial das
# páginas de conteúdo.)

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Tenant deste site dentro do banco compartilhado (dados/{tenant}/<colecao>,
# mesmo padrão multi-tenant do hcCore). Obrigatório — sem valor padrão de
# propósito, pra nunca gravar/ler no tenant errado por engano. Confira o
# valor exato (case-sensitive!) no campo `path` do doc do cliente Portal181
# na coleção raiz `cliente` do hcCore — hoje é "DDBA" (maiúsculo).
NEXT_PUBLIC_PORTAL181_PATH=

# Segredo compartilhado com o hcCore pra chamar POST /api/revalidate
# (invalida o cache de rota do Next.js logo depois de criar/editar/excluir
# um registro no painel, em vez de esperar o `revalidate` de cada página
# — ver app/api/revalidate/route.ts). Roda só no servidor, não leva
# NEXT_PUBLIC_.
REVALIDATE_SECRET=
